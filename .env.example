# ==============================================================================
# Redpex CRM Monorepo Environment Template
# ==============================================================================

# Backend (Render Web Service)
PORT=5000
NODE_ENV=production
HOST=0.0.0.0
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<atlas_cluster>.mongodb.net/crm?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_signing_key_min_32_chars
FRONTEND_URL=https://your-frontend.vercel.app
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# Frontend (Vercel Project Settings)
VITE_API_URL=https://your-backend.onrender.com/api
VITE_EMAIL_SENDER_NAME=Redpex Fire & Safety
VITE_EMAIL_SENDER_ADDRESS=info@redpex.in
