# ==============================================================================
# Redpex CRM Backend Environment Template (Render Production / Local)
# NOTE: Replace placeholder values with your real configuration.
# DO NOT commit files containing actual secrets to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production
HOST=0.0.0.0

# CORS & Cross-Origin Configuration
# Set to your deployed Vercel frontend URL in production (e.g. https://redpex-crm.vercel.app)
FRONTEND_URL=https://your-frontend.vercel.app
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173,http://localhost:3000

# Centralized MongoDB Atlas URI (Render Environment Variable: MONGODB_URI)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<atlas_cluster>.mongodb.net/crm?retryWrites=true&w=majority

# Authentication & Session Security (Render Environment Variable: JWT_SECRET)
# Use a high-entropy string (min 32 characters) or 2048-bit RSA key pair
JWT_SECRET=your_super_secret_jwt_signing_key_min_32_chars
JWT_EXPIRE=7d

# Redis Distributed Cache & Session Lockout (Optional on Render / Render Redis)
# If omitted or offline, session features and cache safely fallback to in-memory/bypass
REDIS_URL=redis://default:<redis_password>@<redis_host>:<redis_port>

# Cloudinary Storage CDN (Durable file uploads for cloud deployment)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Engine Integration (Groq SDK / Gemini)
GROQ_API_KEY=your_groq_api_key

# Email Notification Service (Brevo / Sendinblue)
BREVO_API_KEY=your_brevo_api_key
EMAIL_SENDER_NAME=Redpex Fire & Safety
EMAIL_SENDER_ADDRESS=info@redpex.in
