# Redpex CRM Frontend Environment Variables (Vercel)
# In production on Vercel, set VITE_API_URL to your Render backend URL (e.g. https://redpex-crm-backend.onrender.com/api)
# In local development, leave VITE_API_URL=/api to use the Vite proxy.
VITE_API_URL=https://your-backend.onrender.com/api
VITE_EMAIL_SENDER_NAME=Redpex Fire & Safety
VITE_EMAIL_SENDER_ADDRESS=info@redpex.in
